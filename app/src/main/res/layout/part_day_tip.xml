<?xml version="1.0" encoding="utf-8"?>
<!-- A day of the week chart, floating over its bar: the day, then its lines; it scrolls when a day holds many -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/day_tip_wide"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="@drawable/card_group"
    android:elevation="@dimen/elevation_chrome"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/tip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/tip_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
