<?xml version="1.0" encoding="utf-8"?>
<!-- A day of the week chart, beside the bar held: the day, then its lines; it scrolls when a day holds many -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/day_tip_wide"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="@drawable/tip_ground"
    android:elevation="@dimen/elevation_chrome"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tip_ink"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/tip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/tip_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
