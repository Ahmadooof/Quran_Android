<?xml version="1.0" encoding="utf-8"?>
<!-- A text field inside a settings card: the card is its ground, no underline of its own. Its hint names it;
     autofill is off unless the field asks for it, as the email one does -->
<EditText xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:importantForAutofill="no"
    tools:ignore="LabelFor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:background="@null"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="top|start"
    android:textAlignment="viewStart"
    android:textColor="@color/text"
    android:textColorHint="@color/text_mute"
    android:textSize="@dimen/row_title" />
