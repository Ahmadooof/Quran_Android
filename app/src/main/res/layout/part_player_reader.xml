<?xml version="1.0" encoding="utf-8"?>
<!--
  Reader player: the footer strip every bottom bar in the app wears — surface,
  seam on top — in place of the translucent black it had, which was a second
  design next to the first and lost its own labels at night, when on_dark turns
  dark.

  Five equal columns, icon over label. Play is the middle one and the only
  filled thing on the strip, an accent disc as it is on the surah list; the rest
  are muted, and repeat turns accent while it is on.

  Container IDs are the click targets; p_play_icon, p_play_label, p_repeat_icon
  and p_repeat_label have IDs because sayPlayer() changes them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:layoutDirection="locale"
    android:background="@drawable/reader_foot"
    android:elevation="@dimen/elevation_player"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/p_locate"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_locate"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/icon_label_gap"
            android:text="@string/label_locate"
            android:textColor="@color/text_mute"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/p_reciter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_reciter"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/icon_label_gap"
            android:text="@string/reciter"
            android:textColor="@color/text_mute"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Play / pause: the one filled thing on the strip. -->
    <LinearLayout
        android:id="@+id/p_play"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <!-- The disc holds either the icon or, while audio is on its way, a spinner. -->
        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:duplicateParentState="true"
            android:background="@drawable/bg_circle_accent">

            <ImageView
                android:id="@+id/p_play_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:tint="@color/on_dark"
                android:src="@drawable/ic_play"
                android:contentDescription="@null" />

            <ProgressBar
                android:id="@+id/p_play_wait"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/on_dark"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/p_play_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/play"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/p_repeat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/p_repeat_icon"
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:src="@drawable/ic_repeat"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/p_repeat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/icon_label_gap"
            android:text="@string/label_repeat"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/p_close"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_close"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/icon_label_gap"
            android:text="@string/close"
            android:textColor="@color/text_mute"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
