<?xml version="1.0" encoding="utf-8"?>
<!-- Reader player: seven equal columns, three either side of play; ids on icons and labels that sayPlayer() changes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:layoutDirection="locale"
    android:background="@drawable/reader_foot"
    android:elevation="@dimen/elevation_player"
    android:visibility="gone"
    android:baselineAligned="false">

    <LinearLayout
        android:id="@+id/p_tajweed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/p_tajweed_icon"
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_tajweed"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/p_tajweed_label"
            style="@style/IconLabel"
            android:text="@string/label_tajweed" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/p_reciter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_reciter"
            android:contentDescription="@null" />

        <TextView
            style="@style/IconLabel"
            android:text="@string/reciter" />
    </LinearLayout>

    <!-- Transliteration over the lit word: accent while on, like repeat -->
    <LinearLayout
        android:id="@+id/p_translit"
        android:contentDescription="@string/translit_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/p_translit_icon"
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_translit"
            android:contentDescription="@null" />

        <TextView
            style="@style/IconLabel"
            android:id="@+id/p_translit_label"
            android:text="@string/label_translit" />
    </LinearLayout>

    <!-- Play / pause: the one filled thing on the strip. -->
    <LinearLayout
        android:id="@+id/p_play"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <!-- The disc holds either the icon or, while audio is on its way, a spinner. -->
        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:duplicateParentState="true"
            android:background="@drawable/bg_circle_accent">

            <ImageView
                android:id="@+id/p_play_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:tint="@color/on_dark"
                android:src="@drawable/ic_play"
                android:contentDescription="@null" />

            <ProgressBar
                android:id="@+id/p_play_wait"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/on_dark"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            style="@style/IconLabel"
            android:id="@+id/p_play_label"
            android:layout_marginTop="2dp"
            android:text="@string/play"
            android:textColor="@color/text_mute"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The chosen word on its own, from the word-by-word recordings -->
    <LinearLayout
        android:id="@+id/p_word"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/word_play_name">

        <ImageView
            android:id="@+id/p_word_icon"
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_word_play"
            android:contentDescription="@null" />

        <TextView
            style="@style/IconLabel"
            android:id="@+id/p_word_label"
            android:text="@string/label_word" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/p_repeat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/p_repeat_icon"
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_repeat"
            android:contentDescription="@null" />

        <TextView
            style="@style/IconLabel"
            android:id="@+id/p_repeat_label"
            android:text="@string/label_repeat" />
    </LinearLayout>

    <!-- Recitation speed; the label is the speed itself -->
    <LinearLayout
        android:id="@+id/p_speed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/row_flat"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/speed_name">

        <ImageView
            android:id="@+id/p_speed_icon"
            android:layout_width="@dimen/icon_nav"
            android:layout_height="@dimen/icon_nav"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_speed"
            android:contentDescription="@null" />

        <TextView
            style="@style/IconLabel"
            android:id="@+id/p_speed_label"
            android:text="@string/speed_normal" />
    </LinearLayout>
</LinearLayout>
