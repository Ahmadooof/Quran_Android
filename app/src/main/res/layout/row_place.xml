<?xml version="1.0" encoding="utf-8"?>
<!-- Recent surah or saved page: kind disc, surah, place and progress, then time or remove -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="locale"
    android:background="@drawable/row_flat"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="@dimen/row_pad_v"
    android:paddingBottom="@dimen/row_pad_v">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/chip_soft">

        <ImageView
            android:id="@+id/place_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <include
            android:id="@+id/place_title"
            layout="@layout/part_surah_title" />

        <TextView
            android:id="@+id/place_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_mute"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- How far through the surah: the filled share, then the rest. Weights set in code. -->
        <LinearLayout
            android:id="@+id/place_track"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:background="@color/line"
            android:visibility="gone">

            <View
                android:id="@+id/place_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/accent" />

            <View
                android:id="@+id/place_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/place_when"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textColor="@color/text_mute"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/place_remove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="11dp"
        android:src="@drawable/ic_close"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/remove_mark"
        android:visibility="gone" />
</LinearLayout>
