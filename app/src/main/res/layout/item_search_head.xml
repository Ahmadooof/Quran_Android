<?xml version="1.0" encoding="utf-8"?>
<!--
  A section title. Small, muted, and on the list's own paper: it names the group
  under it without becoming a row in its own right.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:textColor="@color/text_mute"
    android:textSize="11sp"
    android:includeFontPadding="false"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingTop="14dp"
    android:paddingBottom="6dp" />
