<?xml version="1.0" encoding="utf-8"?>
<!-- Surah row: full width, separated by a 1dp line -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Horizontal content row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="6dp">

        <!-- The surah's number, in the same figures the page and running head use. -->
        <TextView
            android:id="@+id/num"
            android:layout_width="@dimen/num_disc"
            android:layout_height="@dimen/num_disc"
            android:gravity="center"
            android:background="@drawable/num_circle"
            android:textColor="@color/on_dark"
            android:textSize="@dimen/num_disc_text"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- The name as the mushaf writes it, its English name beneath. Padding here so the buttons can match the full row height -->
        <LinearLayout
            android:id="@+id/name_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:paddingTop="@dimen/row_pad_v"
            android:paddingBottom="@dimen/row_pad_v">

            <!-- Baseline-aligned, so the two glyphs sit on one line of writing; always read right to left. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="rtl"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textSize="@dimen/surah_title" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textSize="@dimen/surah_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAlignment="viewStart"
                android:textColor="@color/text_mute"
                android:includeFontPadding="false"
                android:textSize="@dimen/surah_english"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Where it lies: its juz over the pages it spans, lined up down the list beside the buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/meta_juz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_mute"
                android:includeFontPadding="false"
                android:textSize="@dimen/row_meta"
                android:maxLines="1" />

            <TextView
                android:id="@+id/meta_pages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/meta_stack_gap"
                android:textColor="@color/text_mute"
                android:includeFontPadding="false"
                android:textSize="@dimen/row_meta"
                android:maxLines="1" />
        </LinearLayout>

        <include layout="@layout/part_row_actions" />
    </LinearLayout>

    <!-- Separator line between rows. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

</LinearLayout>
