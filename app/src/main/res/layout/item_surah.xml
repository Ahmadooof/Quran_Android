<?xml version="1.0" encoding="utf-8"?>
<!-- Surah row: full width, separated by a 1dp line -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Horizontal content row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="6dp">

        <!-- The surah's number, in the same figures the page and running head use. -->
        <TextView
            android:id="@+id/num"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/num_circle"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Padding here so the buttons can match the full row height -->
        <LinearLayout
            android:id="@+id/name_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:paddingTop="@dimen/row_pad_v"
            android:paddingBottom="@dimen/row_pad_v">

            <!-- Baseline-aligned, so the two glyphs sit on one line of writing; always read right to left. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="rtl"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/text_mute"
                android:includeFontPadding="false"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Play -->
        <LinearLayout
            android:id="@+id/btn_play"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- The disc, with a spinner laid over it while this surah's audio is on its way. -->
            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:duplicateParentState="true"
                    android:background="@drawable/chip_soft"
                    android:padding="4dp"
                    android:tint="@color/accent"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@null" />

                <ProgressBar
                    android:id="@+id/play_wait"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="@string/play"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Reciter -->
        <LinearLayout
            android:id="@+id/btn_reciter"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/reciter"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:tint="@color/icon_btn"
                android:src="@drawable/ic_reciter"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="@string/reciter"
                android:textColor="@color/icon_btn"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

    <!-- Separator line between rows. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

</LinearLayout>
