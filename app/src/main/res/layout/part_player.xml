<?xml version="1.0" encoding="utf-8"?>
<!--
  The player, used by the index screen.
  Transport reads outward from the middle: one filled circle for play,
  muted satellites either side. Tapping the bare bar follows the reader.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="locale"
    android:background="@drawable/strip_surface"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Right of centre: locate, then reciter. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <ImageView
            android:id="@+id/p_locate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:contentDescription="@string/locate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_locate" />

        <ImageView
            android:id="@+id/p_reciter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="10dp"
            android:contentDescription="@string/reciter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_reciter" />
    </LinearLayout>

    <!-- The centre: filled circle for play. -->
    <ImageView
        android:id="@+id/p_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:padding="10dp"
        android:contentDescription="@string/play"
        android:background="@drawable/bg_circle_accent"
        android:tint="@color/on_dark"
        android:src="@drawable/ic_play" />

    <!-- Left of centre: repeat, then close. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">

        <ImageView
            android:id="@+id/p_repeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:contentDescription="@string/repeat"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_repeat" />

        <ImageView
            android:id="@+id/p_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="10dp"
            android:contentDescription="@string/close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</LinearLayout>
