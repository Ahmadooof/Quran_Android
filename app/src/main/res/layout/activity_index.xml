<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/index_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:fitsSystemWindows="true"
    android:background="@color/surface_2">

    <!-- Pane area: surahs, bookmarks, or settings. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Pane 0: the index, four lists a swipe apart; filled by IndexPane -->
        <LinearLayout
            android:id="@+id/pane_index"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface_2">

            <!-- Which list: tap or swipe. First child, so the status bar takes its colour -->
            <include
                android:id="@+id/segments"
                layout="@layout/part_segments" />

            <!-- Weighted, not match_parent, or the last rows hang below the screen out of reach -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/lists"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layoutDirection="locale" />
        </LinearLayout>

        <!-- Search: the box, then surahs, pages and ayahs that match -->
        <LinearLayout
            android:id="@+id/pane_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface_2"
            android:visibility="gone">

            <!-- First child, which paintBars reads for the status bar colour -->
            <FrameLayout
                android:id="@+id/search_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/strip_head"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

            <!-- Search pill: outlined, since it is white on white. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/search_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_mute"
                    android:contentDescription="@string/search_hint" />

                <EditText
                    android:id="@+id/search"
                    android:importantForAutofill="no"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_mute"
                    android:textSize="14sp"
                    android:background="@null"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />

                <!-- Empties the box; shown only while there is something in it -->
                <ImageView
                    android:id="@+id/search_clear"
                    android:layout_width="@dimen/row_button"
                    android:layout_height="@dimen/row_button"
                    android:layout_marginEnd="-12dp"
                    android:padding="13dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/row_flat"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/search_clear"
                    android:visibility="gone" />
            </LinearLayout>
            </FrameLayout>

            <!-- What can be searched, until something is typed -->
            <TextView
                android:id="@+id/search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/section_inset"
                android:paddingEnd="@dimen/section_inset"
                android:paddingTop="@dimen/section_gap"
                android:gravity="center"
                android:text="@string/search_empty"
                android:textColor="@color/text_mute"
                android:textSize="@dimen/row_title"
                android:lineSpacingMultiplier="1.3" />

            <!-- Weighted, not match_parent, or the last results hang below the screen out of reach -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/list_end_pad" />
        </LinearLayout>

        <!-- Places: pages read, surahs read and saved pages, a swipe apart; filled by PlacesPane -->
        <LinearLayout
            android:id="@+id/pane_marks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- First child, so the status bar takes its colour -->
            <include
                android:id="@+id/marks_segments"
                layout="@layout/part_segments" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/marks_pages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layoutDirection="locale" />
        </LinearLayout>

        <!-- Achievements: goal, reading, khatma and listening, a swipe apart; filled by StatsPane -->
        <LinearLayout
            android:id="@+id/pane_stats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface_2"
            android:visibility="gone">

            <!-- First child, so the status bar takes its colour -->
            <include
                android:id="@+id/stats_segments"
                layout="@layout/part_segments" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/stats_pages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layoutDirection="locale" />
        </LinearLayout>

        <!-- Pane 3: settings. -->
        <ScrollView
            android:id="@+id/pane_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="24dp">

                <!-- Filled by SettingsPane: titled groups of rows. -->
                <LinearLayout
                    android:id="@+id/settings_groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Continue reading strip: accent only on the disc, surah and page are the prominent part -->
    <LinearLayout
        android:id="@+id/card_resume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="locale"
        android:background="@drawable/strip_resume"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/card_pad_v"
        android:paddingBottom="@dimen/card_pad_v"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- A soft disc, so the icon is held rather than loose on the surface. -->
        <FrameLayout
            android:layout_width="@dimen/num_disc"
            android:layout_height="@dimen/num_disc"
            android:background="@drawable/chip_soft">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark"
                android:tint="@color/accent"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- The label, then the surah as the list writes it; the page sits apart at the end and yields first. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resume"
                android:textColor="@color/text_mute"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:maxLines="1" />

            <include
                android:id="@+id/resume_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                layout="@layout/part_surah_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/resume_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_mute"
            android:includeFontPadding="false"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron"
            android:tint="@color/text_mute"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Bottom navigation: only the icon and label change colour -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:background="@drawable/strip_surface">

        <include
            android:id="@+id/nav_surahs"
            layout="@layout/part_nav_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <include
            android:id="@+id/nav_search"
            layout="@layout/part_nav_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <include
            android:id="@+id/nav_marks"
            layout="@layout/part_nav_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <include
            android:id="@+id/nav_stats"
            layout="@layout/part_nav_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <include
            android:id="@+id/nav_settings"
            layout="@layout/part_nav_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
