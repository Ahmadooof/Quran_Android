<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/index_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:fitsSystemWindows="true"
    android:background="@color/surface_2">

    <!-- Pane area: surahs, bookmarks, or settings. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Pane 0: surah list with search. -->
        <LinearLayout
            android:id="@+id/pane_index"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/paper">

            <!-- Head strip is the pane's first child, which paintBars reads for the status bar colour -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/strip_head"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

            <!-- Search pill: outlined, since it is white on white. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/search_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_mute"
                    android:contentDescription="@string/search_hint" />

                <EditText
                    android:id="@+id/search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_mute"
                    android:textSize="13sp"
                    android:background="@null"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />
            </LinearLayout>
            </FrameLayout>

            <!-- Weighted, not match_parent, or the last results hang below the screen out of reach -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- Places pane: recent surahs and saved pages, filled by PlacesPane -->
        <ScrollView
            android:id="@+id/pane_marks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/places_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>

        <!-- Pane 2: settings. -->
        <ScrollView
            android:id="@+id/pane_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="24dp">

                <!-- Filled by SettingsPane: titled groups of rows. -->
                <LinearLayout
                    android:id="@+id/settings_groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Continue reading strip: accent only on the disc, surah and page are the prominent part -->
    <LinearLayout
        android:id="@+id/card_resume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="locale"
        android:background="@drawable/strip_resume"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/card_pad_v"
        android:paddingBottom="@dimen/card_pad_v"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- A soft disc, so the icon is held rather than loose on the surface. -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chip_soft">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark"
                android:tint="@color/accent"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- The label, then the surah as the list writes it; the page sits apart at the end. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resume"
                android:textColor="@color/accent"
                android:includeFontPadding="false"
                android:textSize="12sp" />

            <include
                android:id="@+id/resume_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                layout="@layout/part_surah_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/resume_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_mute"
            android:includeFontPadding="false"
            android:textSize="13sp"
            android:maxLines="1" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron"
            android:tint="@color/text_mute"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Bottom navigation: only the icon and label change colour -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@drawable/strip_surface">

        <LinearLayout
            android:id="@+id/nav_surahs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/nav_pill_surahs"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/nav_icon_surahs"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_surahs_outline"
                    android:tint="@color/accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/nav_label_surahs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="@string/tab_index"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_marks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/nav_pill_marks"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/nav_icon_marks"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_bookmark_outline"
                    android:tint="@color/icon_btn" />
            </FrameLayout>

            <TextView
                android:id="@+id/nav_label_marks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="@string/tab_marks"
                android:textColor="@color/icon_btn"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/nav_pill_settings"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/nav_icon_settings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_settings_outline"
                    android:tint="@color/icon_btn" />
            </FrameLayout>

            <TextView
                android:id="@+id/nav_label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="@string/tab_settings"
                android:textColor="@color/icon_btn"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
