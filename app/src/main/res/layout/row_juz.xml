<?xml version="1.0" encoding="utf-8"?>
<!-- Juz row: the number, the surah it begins in, and where; seamed like the surah list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/juz_num"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/num_circle"
            android:textColor="@color/on_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Padding here so the buttons can match the full row height -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:paddingTop="@dimen/row_pad_v"
            android:paddingBottom="@dimen/row_pad_v">

            <TextView
                android:id="@+id/juz_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/juz_where"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_mute"
                android:textSize="@dimen/row_meta" />
        </LinearLayout>

        <!-- Play starts the recitation at this juz; the reciter is chosen for the whole app -->
        <include layout="@layout/part_row_actions" />
    </LinearLayout>

    <!-- Separator line between rows. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

</LinearLayout>
