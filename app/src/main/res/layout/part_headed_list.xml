<?xml version="1.0" encoding="utf-8"?>
<!-- A places list under its heading, which stays put while the rows scroll -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/list_head"
        layout="@layout/item_list_head" />

    <!-- The app's thin scrollbar; the big handle is the index lists' own -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_end_pad"
        android:scrollbars="vertical" />
</LinearLayout>
