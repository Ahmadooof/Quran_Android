<?xml version="1.0" encoding="utf-8"?>
<!-- Colour row: tap opens the picker, the reset button restores the default -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="locale"
    android:background="@drawable/row_flat"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="52dp"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/set_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <!-- The colour as it stands. -->
    <ImageView
        android:id="@+id/set_dot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/dot_edge"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_circle"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/set_reset"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:src="@drawable/ic_reset"
        android:tint="@color/icon_btn"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/reset" />
</LinearLayout>
