<?xml version="1.0" encoding="utf-8"?>
<!-- A sheet for choosing a surah: what it asks, a search by name or number, and every surah beneath -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="@drawable/sheet"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/grip" />

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/text_mute"
        android:textSize="@dimen/text_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/search_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/picker_search_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/picker_search"
            android:importantForAutofill="no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/surah_search_hint"
            android:textColor="@color/text"
            android:textColorHint="@color/text_mute"
            android:textSize="@dimen/text_body"
            android:background="@null"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:inputType="text"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/picker_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picker_list_height"
        android:layout_marginTop="6dp"
        android:scrollbars="vertical" />
</LinearLayout>
