<?xml version="1.0" encoding="utf-8"?>
<!--
  An ayah result. The line itself leads and its reference follows quietly: the
  reader is scanning the words to find the one they meant, and will only look at
  the surah and number once they have.

  The text is the plain searchable edition, not the mushaf's own glyphs — those
  belong to the page, and the page is one tap away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="@drawable/row_bg"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/ayah_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:textDirection="rtl"
        android:lineSpacingExtra="3dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ayah_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/accent"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/line" />
</LinearLayout>
