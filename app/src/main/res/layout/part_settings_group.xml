<?xml version="1.0" encoding="utf-8"?>
<!--
  A titled group of settings: the title on the pane's own ground, the rows
  together in one card beneath it. clipToOutline so a row that paints its own
  ground — the preview line — keeps to the card's rounded corners.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin">

    <TextView
        android:id="@+id/group_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_mute"
        android:textSize="12sp"
        android:includeFontPadding="false" />

    <LinearLayout
        android:id="@+id/group_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_group"
        android:clipToOutline="true" />
</LinearLayout>
