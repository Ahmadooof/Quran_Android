<?xml version="1.0" encoding="utf-8"?>
<!--
  Text-selection-style tooltip: two actions side by side, floating above the
  word the reader long-pressed. Elevation gives it a subtle shadow so it reads
  as a floating panel without needing a border or a caret.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_tooltip"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/tip_word"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/listen_word"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/tip_ayah"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/listen_ayah"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
