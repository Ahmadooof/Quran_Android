<?xml version="1.0" encoding="utf-8"?>
<!-- Juz, hizb or page row: the number, its name, and where it begins; seamed like the surah list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/div_num"
            android:layout_width="@dimen/num_disc"
            android:layout_height="@dimen/num_disc"
            android:gravity="center"
            android:background="@drawable/num_circle"
            android:textColor="@color/on_dark"
            android:textSize="@dimen/num_disc_text"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Padding here so the buttons can match the full row height -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:paddingTop="@dimen/row_pad_v"
            android:paddingBottom="@dimen/row_pad_v">

            <!-- The part, and beside it in grey its surahs, as the surah list writes them -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/div_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="@dimen/part_title"
                    android:textStyle="bold" />

                <!-- Filled from code: one surah title, or several names on a page that holds several -->
                <LinearLayout
                    android:id="@+id/div_surahs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/part_surah_gap"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl" />
            </LinearLayout>

            <!-- The quiet line: on a page row its surahs first, then the rest well apart from them -->
            <LinearLayout
                android:id="@+id/div_under"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/div_surahs_under"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/part_meta_gap"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl" />

                <TextView
                    android:id="@+id/div_where"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_mute"
                    android:textSize="@dimen/row_meta" />
            </LinearLayout>

            <!-- A hizb's start, quarter, half and three-quarters, each a pie and the page it begins on -->
            <LinearLayout
                android:id="@+id/div_quarters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/div_q0"
                    style="@style/QuarterMark" />
                <TextView
                    android:id="@+id/div_q1"
                    style="@style/QuarterMark" />
                <TextView
                    android:id="@+id/div_q2"
                    style="@style/QuarterMark" />
                <TextView
                    android:id="@+id/div_q3"
                    style="@style/QuarterMark" />
            </LinearLayout>
        </LinearLayout>

        <!-- Play starts the recitation here; the reciter is chosen for the whole app -->
        <include layout="@layout/part_row_actions" />
    </LinearLayout>

    <!-- Separator line between rows. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

</LinearLayout>
