<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline ring so a white or paper colour dot still shows on a white card -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="@dimen/hairline" android:color="@color/line" />
</shape>
