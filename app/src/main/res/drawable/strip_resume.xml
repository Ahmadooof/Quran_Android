<?xml version="1.0" encoding="utf-8"?>
<!-- Resume strip: plain surface with a top seam and a ripple, since it is tappable -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_soft">
    <item>
        <layer-list>
            <item android:drawable="@color/surface" />
            <item
                android:drawable="@color/line"
                android:gravity="top"
                android:height="1dp" />
        </layer-list>
    </item>
</ripple>
