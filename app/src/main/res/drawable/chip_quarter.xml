<?xml version="1.0" encoding="utf-8"?>
<!-- A hizb quarter's chip: outlined, so it reads as something to tap, with the touch shown on it -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_soft">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/quarter_chip_radius" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</ripple>
