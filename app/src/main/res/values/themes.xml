<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The base. values-v27 adds drawing into the camera cutout, which is
         where the attribute for it arrived; below that there are no cutouts. -->
    <style name="Theme.Quran" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- What is on screen between the activity starting and the first
             paint of the page. Paper, so there is nothing to see happen. -->
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- No title bar on the index either: the bottom nav names what is under
         it, and a heading above would only have said it twice.

         Cairo throughout: the UI is Arabic first, and the system sans has no
         opinion about Arabic worth keeping. -->
    <style name="Theme.Quran.Index" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/surface_2</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- A sheet, not a box in the middle of the page: no frame, no title, and
         it rises from the bottom edge every menu in the app is anchored to. -->
    <style name="SheetDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
