<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. values-v27 repeats it with cutout drawing. Cairo is set here so every screen uses it -->
    <style name="Theme.Quran" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Paper before the first draw, so nothing flashes -->
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- No title bar: the bottom nav already names each pane -->
    <!-- Parented on Theme.Quran so the v27 cutout mode applies here too; bar colours are only the launch guess -->
    <style name="Theme.Quran.Index" parent="Theme.Quran">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <!-- Bottom sheet dialog: no frame and no title -->
    <style name="SheetDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
