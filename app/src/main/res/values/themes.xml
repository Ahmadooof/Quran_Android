<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The base. values-v27 adds drawing into the camera cutout, which is
         where the attribute for it arrived; below that there are no cutouts,
         and it has to repeat every item here, because a style in a qualified
         folder replaces this one rather than adding to it.

         Cairo throughout, set here so every screen has it: the UI is Arabic
         first, and the system sans has no opinion about Arabic worth keeping.
         It used to live on the index theme alone, which left the reader's bars
         and sheets in the system font beside an index in Cairo. The mushaf is
         untouched — its pages draw from their own glyph faces on the canvas. -->
    <style name="Theme.Quran" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- What is on screen between the activity starting and the first
             paint of the page. Paper, so there is nothing to see happen. -->
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- No title bar on the index either: the bottom nav names what is under
         it, and a heading above would only have said it twice. -->
    <!--
      Parented on the reader's theme rather than on AppCompat directly, so that
      values-v27's Theme.Quran carries the cutout mode down here too: the index
      reaches into the camera strip the same way the page does, and one statement
      of that rule serves both.

      The bar colours here are only what the launch window shows, in the moment
      before the activity exists to measure anything: surface, because the index
      opens on the surah pane and its head strip is surface. From first draw on,
      paintBars() reads the colour off the pane actually on screen, so these two
      lines are a starting guess and not the rule.
    -->
    <style name="Theme.Quran.Index" parent="Theme.Quran">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <!-- A sheet, not a box in the middle of the page: no frame, no title, and
         it rises from the bottom edge every menu in the app is anchored to. -->
    <style name="SheetDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
