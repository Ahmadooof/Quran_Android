<?xml version="1.0" encoding="utf-8"?>
<!-- Spacing tokens for values used in more than one layout -->
<resources>

    <!-- Horizontal margin between screen edge and cards / containers -->
    <dimen name="screen_margin">12dp</dimen>

    <!-- Lists and settings stop growing here; wider screens centre them -->
    <dimen name="content_max_width">640dp</dimen>

    <!-- Vertical padding inside list rows (top and bottom) -->
    <dimen name="row_pad_v">11dp</dimen>

    <!-- Vertical padding inside compact cards / chips -->
    <dimen name="card_pad_v">8dp</dimen>

    <!-- Icon sizes -->
    <dimen name="icon_nav">22dp</dimen>   <!-- chrome bar + bottom nav -->


    <!-- Chrome bar button row height (icon 22dp + 3dp gap + ~14dp label + padding) -->
    <dimen name="chrome_row_height">60dp</dimen>

    <!-- Gap between icon and its text label in chrome / nav buttons -->
    <dimen name="icon_label_gap">3dp</dimen>

    <!-- The width of every seam and edge line. -->
    <dimen name="hairline">1dp</dimen>

    <!-- The one line of a real page used to preview reading style. -->
    <!-- Tall enough to hold the head and folio figures either side of the line -->
    <dimen name="preview_line">84dp</dimen>

    <!-- The space above a settings card that has no title of its own. -->
    <dimen name="group_gap">12dp</dimen>


    <dimen name="elevation_chrome">6dp</dimen>
    <dimen name="elevation_player">8dp</dimen>

    <!-- A surah's name in the mushaf hand: the index lists, then rows inside other screens -->
    <dimen name="surah_title">26sp</dimen>
    <dimen name="surah_title_row">22sp</dimen>
    <!-- A row's own title, the quiet line under it, and the label under an icon -->
    <dimen name="row_title">15sp</dimen>
    <!-- A juz, hizb or page row's name, as large as a surah row's name reads -->
    <dimen name="part_title">18sp</dimen>
    <!-- A surah's English name, beside its calligraphy in a row -->
    <dimen name="surah_english">14sp</dimen>
    <!-- Between a surah's juz and its pages, stacked beside the row's buttons -->
    <dimen name="meta_stack_gap">5dp</dimen>
    <dimen name="row_meta">11sp</dimen>
    <!-- The accent value at the end of a settings or statistics row -->
    <dimen name="row_value">14sp</dimen>
    <dimen name="icon_label">10sp</dimen>
    <dimen name="nav_label">11sp</dimen>
    <!-- Room under a list's last row -->
    <dimen name="list_end_pad">8dp</dimen>
    <!-- Scrollbars: the thin one, and the handle a long list can be dragged by -->
    <dimen name="scroll_thin">4dp</dimen>
    <dimen name="scroll_handle">8dp</dimen>
    <dimen name="scroll_handle_held">12dp</dimen>
    <dimen name="scroll_handle_tall">52dp</dimen>
    <dimen name="scroll_handle_inset">4dp</dimen>
    <!-- The strip at the edge that takes hold of the handle -->
    <dimen name="scroll_handle_reach">44dp</dimen>
    <!-- The index switch above the lists -->
    <dimen name="seg_height">36dp</dimen>
    <dimen name="seg_text">14sp</dimen>
    <dimen name="icon_label_min">7sp</dimen>
    <!-- Smallest the reader bar's juz and page may shrink to under a large font -->
    <dimen name="bar_place_min">8sp</dimen>

    <!-- The numbered disc that opens a surah, juz or search row -->
    <dimen name="num_disc">32dp</dimen>
    <dimen name="num_disc_text">12sp</dimen>

    <!-- A lone icon button inside a row: big enough to hit without a second try -->
    <dimen name="row_button">44dp</dimen>
    <!-- A thin progress track under a row -->
    <dimen name="track_height">3dp</dimen>
    <!-- The statistics chart of recent days -->
    <dimen name="chart_height">120dp</dimen>
    <!-- Statistics: the ring that tells a figure large, and the small tiles beside it -->
    <dimen name="ring_size">96dp</dimen>
    <dimen name="ring_stroke">8dp</dimen>
    <!-- Text inside a ring is part of the ring, so it is sized in dp with it: large phone text would overflow the circle -->
    <dimen name="ring_unit">11dp</dimen>
    <!-- Three goal rings side by side: today, the week, the month -->
    <dimen name="ring_small">80dp</dimen>
    <dimen name="ring_small_value">22dp</dimen>
    <dimen name="hero_value">26dp</dimen>
    <dimen name="tile_value">20sp</dimen>
    <!-- A long figure, such as hours and minutes, shrinks to this rather than being cut -->
    <dimen name="tile_value_min">12sp</dimen>
    <dimen name="tile_pad">14dp</dimen>
    <dimen name="tile_disc">30dp</dimen>
    <dimen name="tile_icon">16dp</dimen>
    <dimen name="tile_gap">10dp</dimen>
    <!-- Room for a tile with a two-line label and a trend chip, so every tile on the tab is one size -->
    <dimen name="tile_min_height">118dp</dimen>
    <dimen name="trend_icon">14dp</dimen>
    <dimen name="pill_radius">12dp</dimen>
    <dimen name="section_title">18sp</dimen>
    <dimen name="section_gap">22dp</dimen>
    <!-- Lines the section title up with the cards' own titles -->
    <dimen name="section_inset">18dp</dimen>
    <dimen name="chart_label">10sp</dimen>
    <dimen name="chart_gap">6dp</dimen>
    <!-- Toggle buttons and page tiles: chosen is filled, not chosen is outlined -->
    <dimen name="choice_radius">12dp</dimen>
    <dimen name="choice_tile">48dp</dimen>
    <dimen name="choice_gap">4dp</dimen>
    <dimen name="mark_button_height">36dp</dimen>
    <dimen name="mark_button_text">13sp</dimen>
    <dimen name="mark_button_icon">16dp</dimen>
    <!-- The arrow at the end of a tappable statistics row -->
    <dimen name="row_go">18dp</dimen>
    <!-- A compact switch, in scale with the rows' text: a rounded track, a knob that slides -->
    <dimen name="switch_width">40dp</dimen>
    <dimen name="switch_height">24dp</dimen>
    <dimen name="switch_radius">12dp</dimen>
    <dimen name="switch_knob_box">20dp</dimen>
    <!-- A bar of the week chart, round-ended; and its words: pages over it, the day under it -->
    <dimen name="chart_bar">26dp</dimen>
    <dimen name="chart_bar_corner">6dp</dimen>
    <dimen name="chart_count">13sp</dimen>
    <dimen name="chart_day">12sp</dimen>
    <dimen name="legend_dot">10dp</dimen>
    <!-- Setting a goal: the minus and plus buttons, the number between them, a weekday button -->
    <dimen name="step_button">40dp</dimen>
    <dimen name="step_value">64dp</dimen>
    <dimen name="day_choice">40dp</dimen>
    <!-- A hizb row's quarter pies, and the room between one and the next -->
    <dimen name="quarter_icon">17dp</dimen>
    <dimen name="quarter_text">13sp</dimen>
    <dimen name="quarter_gap">6dp</dimen>
    <dimen name="quarter_chip_height">36dp</dimen>
    <dimen name="quarter_chip_radius">18dp</dimen>
    <!-- The bubble beside a held list handle, naming where the drag has reached -->
    <dimen name="scroll_bubble_gap">12dp</dimen>
    <dimen name="scroll_bubble_pad_x">16dp</dimen>
    <dimen name="scroll_bubble_pad_y">8dp</dimen>
    <dimen name="scroll_bubble_text">15sp</dimen>
    <!-- The juz heading pinned over the pages list -->
    <dimen name="pinned_head_height">36dp</dimen>
    <dimen name="pinned_pill_height">26dp</dimen>
    <dimen name="pinned_pill_pad">12dp</dimen>
    <!-- Each of a download row's three buttons: save to phone, share, download -->
    <dimen name="dl_button">60dp</dimen>
</resources>
