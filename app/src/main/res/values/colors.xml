<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mushaf paper; also the window background. Keep in step with the website's paper colour -->
    <color name="paper">#FFFDF7</color>
    <color name="ink">#1A1A1A</color>

    <!-- Same palette as the website -->
    <color name="accent">#1A6FA3</color>
    <!-- App icon: cream calligraphy on the app's blue; the same by day and night. -->
    <color name="icon_ground">#1A6FA3</color>
    <color name="icon_ink">#FFFDF7</color>
    <color name="accent_soft">#4D1A6FA3</color>
    <color name="surface">#FFFFFF</color>
    <!-- Reader bars over the page: a cool tint, since white on warm paper read as the same sheet -->
    <color name="reader_chrome">#F1F6FC</color>
    <!-- Every screen's ground, lists included, so the tabs read as one app -->
    <color name="surface_2">#F5F9FD</color>
    <!-- Scrollbar at rest: visible on any ground, never louder than the text -->
    <color name="scroll_thumb">#B3577284</color>
    <!-- Gold among the confetti when the day's goal is reached -->
    <color name="confetti_gold">#E0B341</color>
    <color name="line">#DCE8F2</color>
    <color name="text">#16283A</color>
    <!-- Dark enough for the 9-11sp labels under the icons to hold 5:1 on white -->
    <color name="text_mute">#577284</color>
    <color name="on_dark">#FFFFFF</color>

    <!-- Highlighted word ink, and what the reset in settings returns to. -->
    <color name="ink_lit">#A4161A</color>
    <!-- The ayah markers on the page, until the reader picks a colour: the accent. -->
    <color name="ayah_mark">@color/accent</color>
    <!-- The week chart's floating day card: the page's colours turned over, so it stands apart from the cards -->
    <color name="tip_ground">#16283A</color>
    <color name="tip_ink">#FFFFFF</color>
    <color name="tip_mute">#AEBBC7</color>
</resources>
