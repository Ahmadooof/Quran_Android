<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mushaf paper; also the window background. Keep in step with the website's paper colour -->
    <color name="paper">#FFFDF7</color>
    <color name="ink">#1A1A1A</color>

    <!-- Same palette as the website -->
    <color name="accent">#1A6FA3</color>
    <!-- App icon: cream calligraphy on the app's blue; the same by day and night. -->
    <color name="icon_ground">#1A6FA3</color>
    <color name="icon_ink">#FFFDF7</color>
    <color name="accent_soft">#4D1A6FA3</color>
    <color name="surface">#FFFFFF</color>
    <!-- Reader bars over the page: white by day, lifted above the page by a shadow. -->
    <color name="reader_chrome">#FFFFFF</color>
    <color name="surface_2">#F5F9FD</color>
    <color name="line">#DCE8F2</color>
    <color name="text">#16283A</color>
    <color name="text_mute">#6A869B</color>
    <color name="on_dark">#FFFFFF</color>

    <!-- Surah names and Basmalah: blue by day, gold at night -->
    <color name="ornament">#1A6FA3</color>
    <!-- Highlighted word ink, and what the reset in settings returns to. -->
    <color name="ink_lit">#A4161A</color>
    <!-- The ayah markers on the page, until the reader picks a colour: the accent. -->
    <color name="ayah_mark">@color/accent</color>
