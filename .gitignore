# ============================================================
# Android / Gradle
# ============================================================

# Built output
build/
app/build/
*/build/

# Gradle wrapper cache & per-project caches
.gradle/
gradle-app.setting

# Local configuration (contains absolute SDK path — machine-specific)
local.properties

# Signed release keystores — never commit private keys
*.jks
*.keystore

# ProGuard / R8 generated mapping files (keep if you need stack-trace de-obfuscation;
# otherwise exclude to avoid leaking internals)
# app/proguard-rules.pro  ← keep in VCS; it's your config, not generated output

# ============================================================
# IntelliJ IDEA / Android Studio
# ============================================================

# Most .idea files are user/machine state, not project config.
# Keep: .idea/modules.xml, .idea/codeStyles/, .idea/copyright/ (team style/copyright rules)
.idea/
!.idea/codeStyles/
!.idea/codeStyleConfig.xml

# Module files are regenerated by Gradle
*.iml
*.ipr
*.iws

# ============================================================
# Kotlin
# ============================================================

# Kotlin compiler sessions / error caches
.kotlin/

# ============================================================
# OS & editor noise
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# JetBrains Rider / VS Code workspace files
*.swp
*.swo

# ============================================================
# CI / secrets
# ============================================================

# Google Services JSON (contains API keys — add the file manually
# to trusted CI environments rather than committing it)
google-services.json

# Environment / secrets files
.env
.env.*
secrets.properties
